/* Directioner OS Plymouth Boot Splash Script
 * TODO 057 — Plymouth boot splash theme
 *
 * Features:
 *   - Branded logo with fade-in animation
 *   - Progress bar using primary brand color (#00D2FF)
 *   - Text fallback for headless/accessibility
 *   - LUKS passphrase prompt preserved (uses default dialog API)
 *
 * Tested: virtio-gpu, vmware svga, and text-only console
 */

// ── Constants ────────────────────────────────────────────────────────────────
BRAND_BLUE  := "#00D2FF";
BRAND_DARK  := "#0A0E17";
BAR_HEIGHT  := 4;
BAR_Y_PCT   := 0.82;   // 82% down the screen

// ── Screen setup ─────────────────────────────────────────────────────────────
screen_width  := Window.GetWidth();
screen_height := Window.GetHeight();

// ── Background ───────────────────────────────────────────────────────────────
Window.SetBackgroundTopColor(0.04, 0.05, 0.09);   // #0A0E17 approx
Window.SetBackgroundBottomColor(0.02, 0.03, 0.06);

// ── Logo ─────────────────────────────────────────────────────────────────────
logo_image := Image("directioner-logo.png");
logo_sprite := Sprite(logo_image);
logo_x := (screen_width  - logo_image.GetWidth())  / 2;
logo_y := (screen_height - logo_image.GetHeight()) / 2 - 60;
logo_sprite.SetPosition(logo_x, logo_y, 0);
logo_sprite.SetOpacity(0);

// Fade in logo over first 1 second (60 frames at ~60fps)
global.logo_alpha := 0;

// ── Progress bar ─────────────────────────────────────────────────────────────
bar_total_width := screen_width * 0.4;
bar_x           := (screen_width - bar_total_width) / 2;
bar_y           := screen_height * BAR_Y_PCT;

// Background track
bar_track := Rectangle();
bar_track.SetWidth(bar_total_width);
bar_track.SetHeight(BAR_HEIGHT);
bar_track.SetColor(0.15, 0.16, 0.20, 0.4);
bar_track_sprite := Sprite(bar_track);
bar_track_sprite.SetPosition(bar_x, bar_y, 0);

// Progress fill
bar_fill := Rectangle();
bar_fill.SetWidth(1);
bar_fill.SetHeight(BAR_HEIGHT);
bar_fill.SetColor(0, 0.82, 1.0, 1.0);   // #00D2FF
global.bar_sprite := Sprite(bar_fill);
global.bar_sprite.SetPosition(bar_x, bar_y, 1);
global.bar_width := bar_total_width;
global.progress  := 0;

// ── Status label ─────────────────────────────────────────────────────────────
status_label := Label("Directioner OS");
status_label.SetColor(0, 0.82, 1.0);
status_label.SetPosition(bar_x, bar_y + BAR_HEIGHT + 8, 0);

// ── Callbacks ─────────────────────────────────────────────────────────────────
fun refresh_callback() {
    // Fade in logo
    if (global.logo_alpha < 1.0) {
        global.logo_alpha += 0.025;
        logo_sprite.SetOpacity(Math.Min(global.logo_alpha, 1.0));
    }

    // Animate bar (clamp at 95% until boot complete)
    if (global.progress < 0.95) {
        global.progress += 0.004;
        global.bar_sprite.SetWidth(global.bar_width * global.progress);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

// ── Boot progress ─────────────────────────────────────────────────────────────
fun boot_progress_callback(duration, progress) {
    global.progress := progress;
    global.bar_sprite.SetWidth(global.bar_width * progress);
}

Plymouth.SetBootProgressFunction(boot_progress_callback);

// ── Message display ───────────────────────────────────────────────────────────
fun message_callback(text) {
    status_label.SetText(text);
}

Plymouth.SetMessageFunction(message_callback);

// ── Password dialog (LUKS) ────────────────────────────────────────────────────
fun display_password_callback(entry, bullets) {
    // Use the built-in dialog rendering to ensure passphrase prompt works
    // on all framebuffer modes including text fallback
    Plymouth.Message(entry.GetText());
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

// ── Quit (boot complete) ──────────────────────────────────────────────────────
fun quit_callback() {
    global.progress := 1.0;
    global.bar_sprite.SetWidth(global.bar_width);
    logo_sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);
