// Directioner OS — fastfetch configuration (TODO 063)
// Logo: ASCII art from directioner-logos package
// Fields: OS, Image, Kernel, DE, Resolution, Shell, Terminal, CPU, Memory, Disk, Health
//
// Install to: /etc/fastfetch/config.jsonc
// Package: directioner-config
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/directioner/logos/directioner-ascii.txt",
        "type": "file",
        "colors": {
            "1": "cyan",
            "2": "blue"
        },
        "padding": {
            "left": 2,
            "top": 1
        }
    },
    "display": {
        "separator": "  →  ",
        "color": {
            "keys": "cyan",
            "title": "blue"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        "separator",
        {
            "type": "os",
            "key": "OS",
            "format": "{pretty-name}"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "format": "{release}",
            "showNote": true,
            "note": "Note: kernel release string contains fc42 (upstream Fedora build)"
        },
        {
            "type": "custom",
            "key": "Image",
            "format": "{env.IMAGE_ID}"
        },
        {
            "type": "custom",
            "key": "Build",
            "format": "{env.BUILD_ID}"
        },
        {
            "type": "de",
            "key": "DE"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "showPeCoreCount": false
        },
        {
            "type": "gpu",
            "key": "GPU",
            "detectionMethod": "pci"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "disk",
            "key": "Disk  /",
            "folders": "/"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        "separator",
        {
            "type": "colors",
            "paddingLeft": 0
        }
    ]
}
