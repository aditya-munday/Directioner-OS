# Directioner-OS — Hardened bootc image specification (Phase 4.1 / TODO 31)
#
# Multi-target design:
#   - base: Common foundation, pinned by digest, minimal packages, zero credentials.
#   - test: Development & CI testing target (ci user, local ssh key, passwordless sudo, dev tooling).
#   - release: Default production target. Absolutely NO ci user, NO public keys, NO passwordless sudo,
#              NO --exec flags, NO test sockets.
#
# Base image pinning:
# Base image is pinned by sha256 digest to prevent supply-chain drift across builds.
# To bump base digest:
#   podman pull quay.io/fedora/fedora-bootc:42
#   podman inspect --format '{{.Digest}}' quay.io/fedora/fedora-bootc:42
# Update the digest below accordingly.

# Pinned Fedora 42 bootc base
FROM quay.io/fedora/fedora-bootc:42@sha256:077182b6ba853b3348d0bede602ac30b9e6568c6422bcf0654de5af96f19b9c3 AS base

# ------------------------------------------------------------------
# 31.5 Package minimization:
# Only essential runtime dependencies are installed in base.
# Excluded from base/release:
#   - neovim / vim: interactive editor, not needed for headless machine operation.
#   - tmux: terminal multiplexer, not needed on headless server nodes.
#   - htop: interactive process monitor, replaced by world-model and ai-health telemetry.
# Retained essentials:
#   - openssl: cryptographic operations and token HMAC validation.
#   - openssh-server: remote administrative access (configured via first-boot / cloud-init).
#   - greenboot / greenboot-grub2: health check framework for bootc rollback.
# ------------------------------------------------------------------
RUN dnf install -y openssl openssh-server greenboot greenboot-grub2 \
    && dnf clean all

# Mask systemd-ssh-generator (avoids AF_VSOCK crash under virtualized QEMU environments)
RUN mkdir -p /etc/systemd/system-generators \
    && ln -sf /dev/null /etc/systemd/system-generators/systemd-ssh-generator

RUN echo 'Hello from the AI-Native OS build' > /etc/motd \
    && systemctl enable sshd

# ------------------------------------------------------------------
# Phase 3.0.1: Standard Greenboot Required Health Check & Milestone Service
# ------------------------------------------------------------------
COPY configs/systemd/directioner-milestone.service /usr/lib/systemd/system/directioner-milestone.service
COPY configs/greenboot/01_directioner_milestone.sh /etc/greenboot/check/required.d/01_directioner_milestone.sh

# ------------------------------------------------------------------
# Phase 3.1: Default AI Engineer Self-Healing Configuration (Disabled by default)
# ------------------------------------------------------------------
RUN mkdir -p /etc/ai-engineer
COPY configs/ai-engineer/self-healing.toml /etc/ai-engineer/self-healing.toml

RUN chmod 755 /etc/greenboot/check/required.d/01_directioner_milestone.sh \
    && systemctl enable greenboot-healthcheck.service directioner-milestone.service

# ------------------------------------------------------------------
# Phase 0: Native AI Engineer Control Plane Binaries & Systemd Units
# ------------------------------------------------------------------
COPY bin/ /usr/bin/
COPY libexec/ /usr/libexec/
COPY configs/systemd/ai-capabilityd.service /usr/lib/systemd/system/ai-capabilityd.service
COPY configs/systemd/ai-killswitch.service /usr/lib/systemd/system/ai-killswitch.service
COPY configs/systemd/directioner-accountd.service /usr/lib/systemd/system/directioner-accountd.service
COPY configs/systemd/directioner-cloudd.service /usr/lib/systemd/system/directioner-cloudd.service
COPY configs/systemd/directioner-intentd.service /usr/lib/systemd/system/directioner-intentd.service
COPY configs/systemd/serial-getty@ttyS0.service.d/ /usr/lib/systemd/system/serial-getty@ttyS0.service.d/
COPY configs/ai-engineer/ai-capabilityd.default /etc/default/ai-capabilityd
COPY configs/platform.toml /etc/directioner/platform.toml

RUN mkdir -p /var/lib/ai-engineer /etc/ai-engineer /var/lib/ai-bin /var/lib/directioner/accountd /run/directioner \
    && chmod 755 /usr/bin/ai-* /usr/bin/dos-* /usr/bin/directioner-* /usr/libexec/* 2>/dev/null || true \
    && for b in /usr/bin/ai-*; do [ -f "$b" ] && ln -sf "$b" "/var/lib/ai-bin/$(basename "$b")"; done || true \
    && systemctl enable ai-capabilityd.service directioner-accountd.service directioner-cloudd.service directioner-intentd.service

# ==================================================================
# Domain 6: Directioner OS Branding Layer (TODOs 054-070, 083-087)
# ==================================================================

# Install brand token generator dependencies (Python 3.11+ stdlib only)
# Generate derived brand outputs (GRUB colors, Plymouth colors, GTK/Qt tokens)
COPY scripts/generate_brand_tokens.py /usr/libexec/directioner/generate_brand_tokens.py
COPY scripts/validate_brand_toml.py   /usr/libexec/directioner/validate_brand_toml.py
COPY scripts/rebrand_lint.py          /usr/libexec/directioner/rebrand_lint.py
COPY scripts/asset_provenance_scan.py /usr/libexec/directioner/asset_provenance_scan.py
COPY scripts/rebrand_grub.sh          /usr/libexec/directioner/rebrand_grub.sh
COPY brand.toml                        /etc/directioner/brand.toml
COPY design/tokens.json                /etc/directioner/tokens.json

# Install fastfetch for branded system info display (if available)
RUN (dnf install -y fastfetch || true) \
    && dnf clean all

# Apply os-release: Directioner OS identity (TODO 054)
# Replace the upstream Fedora os-release with our branded version.
# ID_LIKE=fedora is intentionally preserved for dnf/rpm-ostree compatibility.
COPY configs/os-release /etc/os-release

# Apply system-release and system-release-cpe (TODO 054)
RUN echo "Directioner OS release 42.0.0 (Genesis)" > /etc/system-release \
    && echo "cpe:/o:directioneros:directioner:42.0.0" > /etc/system-release-cpe

# Apply branded login banners (TODO 055)
COPY configs/issue /etc/issue
RUN echo "Directioner OS 42.0.0 (Genesis) — The AI-Native Operating System" > /etc/issue.net
COPY configs/motd /etc/motd

# GRUB2 distributor branding (TODO 056)
RUN if [ -f /etc/default/grub ]; then \
        sed -i 's|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR="Directioner OS"|' /etc/default/grub || \
        echo 'GRUB_DISTRIBUTOR="Directioner OS"' >> /etc/default/grub; \
    fi

# Apply fastfetch config (TODO 063)
RUN mkdir -p /etc/fastfetch
COPY packaging/directioner-config/SOURCES/fastfetch.jsonc /etc/fastfetch/config.jsonc

# Install branded logos (ASCII + SVG placeholder) (TODO 058)
RUN mkdir -p /usr/share/directioner/logos /usr/share/pixmaps
COPY packaging/directioner-logos/SOURCES/directioner-ascii.txt \
     /usr/share/directioner/logos/directioner-ascii.txt
COPY packaging/directioner-logos/SOURCES/directioner-logo.svg \
     /usr/share/pixmaps/directioner-logo.svg

# Install wallpaper placeholders (TODO 059)
RUN mkdir -p /usr/share/backgrounds/directioner
COPY packaging/directioner-backgrounds/SOURCES/directioner-dark.svg \
     /usr/share/backgrounds/directioner/directioner-dark.svg
COPY packaging/directioner-backgrounds/SOURCES/directioner-light.svg \
     /usr/share/backgrounds/directioner/directioner-light.svg

# Shell profile: branded prompt + login banner (TODO 064)
COPY packaging/directioner-config/SOURCES/directioner-prompt.sh \
     /etc/profile.d/directioner-prompt.sh
COPY packaging/directioner-config/SOURCES/directioner-banner.sh \
     /etc/profile.d/directioner-banner.sh
RUN chmod 644 /etc/profile.d/directioner-prompt.sh \
              /etc/profile.d/directioner-banner.sh

# Hostname scheme config (TODO 083)
COPY packaging/directioner-config/SOURCES/hostname-scheme.conf \
     /etc/directioner/hostname-scheme.conf

# Shortcut map (TODO 085) — documentation only, DE applies at runtime
COPY packaging/directioner-config/SOURCES/shortcuts.toml \
     /usr/share/directioner/config/shortcuts.toml

# Firefox policies (TODO 069) — installed if Firefox is present
RUN mkdir -p /usr/lib/firefox/distribution
COPY packaging/directioner-config/SOURCES/policies.json \
     /usr/lib/firefox/distribution/policies.json

# Repo config (TODO 067) — enabled=0 until hosting is ready (Rule B4)
COPY packaging/directioner-repos/SPECS/directioner-repos.spec \
     /usr/share/directioner/config/directioner-repos.spec.ref
RUN mkdir -p /etc/yum.repos.d
COPY configs/directioner.repo /etc/yum.repos.d/directioner.repo

# GPG key placeholder (OWNER-AUTH TODO 497)
RUN mkdir -p /etc/pki/rpm-gpg \
    && echo "# PLACEHOLDER — Replace with real Directioner OS GPG key (OWNER-AUTH TODO 497)" \
       > /etc/pki/rpm-gpg/RPM-GPG-KEY-directioner

# Post-branding invariant check: os-release ID must be 'directioner'
RUN ID_VALUE=$(grep '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"') \
    && if [ "$ID_VALUE" != "directioner" ]; then \
        echo "FATAL: os-release ID='$ID_VALUE' must be 'directioner'" >&2; exit 1; \
    fi \
    && echo "Brand check OK: ID=directioner"


# ==================================================================
# Target: test (development, local VM, CI runners)
# ==================================================================
FROM base AS test

# Install developer debug and terminal packages
RUN dnf install -y neovim tmux htop \
    && dnf clean all

# Configure test environment with ci user and passwordless sudo
RUN (id -u ci >/dev/null 2>&1 || useradd -m -G wheel -s /bin/bash ci) \
    && echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel \
    && chmod 0440 /etc/sudoers.d/wheel \
    && mkdir -p /home/ci/.ssh \
    && chmod 0700 /home/ci/.ssh \
    && chown -R ci:ci /home/ci/.ssh

# Mark build target identifier
RUN echo "directioner-test-build" > /etc/directioner-build-target

# ==================================================================
# Target: release (hardened production image - default final stage)
# ==================================================================
FROM base AS release

# Ensure absolutely NO wheel passwordless sudo exists
RUN rm -f /etc/sudoers.d/wheel \
    && rm -rf /root/.ssh /home/ci /var/run/test-*.sock \
    && echo "directioner-release-build" > /etc/directioner-build-target

# Invariant verification: Fail the build immediately if release contains forbidden artifacts
RUN if id -u ci >/dev/null 2>&1; then echo "FATAL: ci user present in release image!" >&2; exit 1; fi \
    && if [ -f /etc/sudoers.d/wheel ]; then echo "FATAL: passwordless sudo file present in release!" >&2; exit 1; fi \
    && if [ -f /root/.ssh/authorized_keys ]; then echo "FATAL: authorized_keys found in release /root/.ssh!" >&2; exit 1; fi

# ==================================================================
# Target: desktop (KDE Plasma Wayland - Kinoite atomic base - U009/U010)
# ==================================================================
# Verified base: quay.io/fedora/fedora-kinoite:42 amd64
# manifest digest: sha256:db05d8e07e40741e604d3cc11822987d742c1d0ae3eee5f09c89041bd59379c9
# ostree commit: a1a57b0b7ba958dc200fcd2d856ed375570dd105a3f4c34d2b470a467af74309
# version: 42.20260527.1  containers.bootc=1  ostree.bootable=true
FROM quay.io/fedora/fedora-kinoite:42@sha256:db05d8e07e40741e604d3cc11822987d742c1d0ae3eee5f09c89041bd59379c9 AS desktop

# Apply Directioner branding on top of Kinoite
COPY configs/os-release /etc/os-release
COPY configs/issue /etc/issue
COPY configs/motd /etc/motd
COPY configs/directioner.repo /etc/yum.repos.d/directioner.repo

# Install guest hypervisor tools not in Kinoite base
RUN dnf install -y \
    open-vm-tools \
    open-vm-tools-desktop \
    qemu-guest-agent \
    spice-vdagent \
    && dnf clean all

# Deploy Directioner OS control plane binaries
COPY bin/ /usr/bin/
COPY libexec/ /usr/libexec/

# Greenboot health check for desktop A/B rollback
COPY configs/systemd/directioner-milestone.service /usr/lib/systemd/system/directioner-milestone.service
COPY configs/greenboot/01_directioner_milestone.sh /etc/greenboot/check/required.d/01_directioner_milestone.sh
RUN chmod 755 /etc/greenboot/check/required.d/01_directioner_milestone.sh \
    && systemctl enable greenboot-healthcheck.service directioner-milestone.service \
    && systemctl enable sddm \
    && { systemctl enable vmtoolsd.service 2>/dev/null || true; } \
    && { systemctl enable qemu-guest-agent.service 2>/dev/null || true; } \
    && { systemctl enable spice-vdagentd.service 2>/dev/null || true; } \
    && echo "directioner-desktop-build" > /etc/directioner-build-target

# Post-branding invariant check
RUN ID_VALUE=$(grep '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"') \
    && if [ "$ID_VALUE" != "directioner" ]; then \
        echo "FATAL: os-release ID='$ID_VALUE' must be 'directioner'" >&2; exit 1; \
    fi \
    && echo "Brand check OK: ID=directioner"

# ==================================================================
# Target: desktop-test (Desktop + CI autologin user for smoke tests)
# ==================================================================
FROM desktop AS desktop-test

RUN (id -u testuser >/dev/null 2>&1 || useradd -m -G wheel -s /bin/bash testuser) \
    && echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel \
    && chmod 0440 /etc/sudoers.d/wheel \
    && echo 'testuser:directioner' | chpasswd \
    && mkdir -p /etc/sddm.conf.d \
    && printf '[Autologin]\nUser=testuser\nSession=plasmawayland\n' > /etc/sddm.conf.d/autologin.conf \
    && echo "directioner-desktop-test-build" > /etc/directioner-build-target