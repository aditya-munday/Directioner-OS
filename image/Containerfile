# Directioner-OS — Phase 0.1 bootable custom image
#
# Pipeline: Containerfile (in) → bootc container → bootc-image-builder → qcow2 (out)
# Rule: configuration & layering on top of Fedora — never modify Fedora source.
# Base: Fedora 42 bootc (ostree image). See guide §1.

FROM quay.io/fedora/fedora-bootc:42

# ------------------------------------------------------------------
# Sanity-check layer: prove the pipeline works (guide §1.2).
# A fresh VM must boot with every package + config we add present.
# ------------------------------------------------------------------
RUN dnf install -y neovim tmux htop openssl openssh-server greenboot greenboot-grub2 \
    && dnf clean all

# Mask systemd-ssh-generator (avoids AF_VSOCK crash under virtualized QEMU environments)
RUN mkdir -p /etc/systemd/system-generators \
    && ln -sf /dev/null /etc/systemd/system-generators/systemd-ssh-generator

RUN echo 'Hello from the AI-Native OS build' > /etc/motd \
    && echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel \
    && chmod 0440 /etc/sudoers.d/wheel \
    && systemctl enable sshd

# ------------------------------------------------------------------
# Phase 3.0.1: Standard Greenboot Required Health Check & Milestone Service
# ------------------------------------------------------------------
COPY configs/systemd/directioner-milestone.service /usr/lib/systemd/system/directioner-milestone.service
COPY configs/greenboot/01_directioner_milestone.sh /etc/greenboot/check/required.d/01_directioner_milestone.sh

# ------------------------------------------------------------------
# Phase 3.1: Default AI Engineer Self-Healing Configuration (Disabled by default)
# ------------------------------------------------------------------
RUN mkdir -p /etc/ai-engineer
COPY configs/ai-engineer/self-healing.toml /etc/ai-engineer/self-healing.toml

RUN chmod 755 /etc/greenboot/check/required.d/01_directioner_milestone.sh \
    && systemctl enable greenboot-healthcheck.service directioner-milestone.service

# ------------------------------------------------------------------
# Phase 0: Native AI Engineer Control Plane Binaries & Systemd Units
# ------------------------------------------------------------------
COPY bin/ /usr/bin/
COPY configs/systemd/ai-capabilityd.service /usr/lib/systemd/system/ai-capabilityd.service
COPY configs/systemd/ai-killswitch.service /usr/lib/systemd/system/ai-killswitch.service
COPY configs/systemd/serial-getty@ttyS0.service.d/ /usr/lib/systemd/system/serial-getty@ttyS0.service.d/
COPY configs/ai-engineer/ai-capabilityd.default /etc/default/ai-capabilityd

RUN mkdir -p /var/lib/ai-engineer /etc/ai-engineer /var/lib/ai-bin \
    && chmod 755 /usr/bin/ai-* 2>/dev/null || true \
    && for b in /usr/bin/ai-*; do [ -f "$b" ] && ln -sf "$b" "/var/lib/ai-bin/$(basename "$b")"; done || true \
    && systemctl enable ai-capabilityd.service