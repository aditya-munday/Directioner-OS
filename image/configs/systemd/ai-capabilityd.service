[Unit]
Description=AI Engineer Capability Layer daemon (ai-capabilityd)
Documentation=file:///usr/share/doc/ai-capabilityd/README.md
# Hard dependency: the capability daemon is the only way the AI touches the system.
After=local-fs.target

[Service]
# Type=notify with READY=1 emitted after socket bind and chmod 0600
Type=notify
WatchdogSec=30s

# Shipped default: explicitly authorize root (UID 0) and primary desktop user (UID 1000).
# Administrators on multi-user or enterprise directory systems can override this via /etc/default/ai-capabilityd.
Environment="DIRECTIONER_ALLOWED_UIDS=1000"
EnvironmentFile=-/etc/default/ai-capabilityd
ExecStart=/usr/bin/ai-capabilityd \
    --socket /run/ai-capabilityd/ai-capabilityd.sock \
    --audit-log /var/lib/ai-engineer/worklog.jsonl \
    --lock-file /run/ai-capabilityd/ai-capabilityd.lock \
    --work-root /home
RuntimeDirectory=ai-capabilityd
# Capability Layer needs privilege to perform package/service/file operations.
# Tighten per-operation via SELinux domains (configs/selinux/), never via root shell.
User=root
Restart=on-failure
RestartSec=2

# Defense in depth: the process can only see these paths.
# Lockdown increases below as adapters are wired to SELinux domains.
# Note on ProtectSystem=strict: ProtectSystem=strict mounts /usr, /boot, and /etc read-only
# for this unit. Managed state is confined to ReadWritePaths (/var/lib/ai-engineer, /etc/ai-engineer).
# System mutations (package changes, service restarts) are executed via systemctl/dnf5 subprocesses.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/ai-engineer /etc/ai-engineer
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target