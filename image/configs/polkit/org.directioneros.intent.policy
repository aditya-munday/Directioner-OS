<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Directioner OS Project</vendor>
  <vendor_url>https://github.com/aditya-munday/Directioner-OS</vendor_url>

  <action id="org.directioneros.intent.execute">
    <description>Execute AI System Intent with Rule B1 Authorization</description>
    <message>Authentication is required to execute system-modifying AI intents</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
